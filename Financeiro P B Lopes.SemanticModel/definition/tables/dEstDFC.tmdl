		source =
				DATATABLE (
				    "ORDEM", INTEGER, "CODIGO", STRING, "LINHA", STRING, "ORDEM_GRUPO", INTEGER, "GRUPO", STRING, "TIPO", STRING,
				    {
				        { 1, "OP-RESULTADO", "Resultado do período", 1, "1. ATIVIDADES OPERACIONAIS", "RESULTADO" },
				        { 2, "OP-DEPRECIACAO", "(+) Depreciação e amortização", 1, "1. ATIVIDADES OPERACIONAIS", "CONTAS" },
				        { 3, "OP-CLIENTES", "(Aumento) redução de clientes", 1, "1. ATIVIDADES OPERACIONAIS", "CONTAS" },
