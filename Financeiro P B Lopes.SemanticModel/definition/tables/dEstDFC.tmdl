/// Estrutura da DFC (método indireto): uma linha por item, com a atividade (grupo), a ordem e o tipo de cálculo. Tabela escrita no próprio modelo, sem Excel.
table dEstDFC
	lineageTag: 15b7944f-254e-418a-85e9-33368ea3a527

	column ORDEM
		formatString: 0
		lineageTag: c2eda398-2183-4ed1-9808-c8bf20d26c77
		summarizeBy: none
		isNameInferred
		sourceColumn: [ORDEM]

		annotation SummarizationSetBy = Automatic

	/// Código que liga a linha às contas: é o mesmo valor da coluna dContaBP[DFC Código].
	column CODIGO
		lineageTag: 411eb662-f42d-4639-87f1-eb6788438c03
		summarizeBy: none
		isNameInferred
		sourceColumn: [CODIGO]

		annotation SummarizationSetBy = Automatic

	column LINHA
		lineageTag: f7872c43-ea3b-4b5b-83d9-11899ea36338
		summarizeBy: none
		isNameInferred
		sourceColumn: [LINHA]
		sortByColumn: ORDEM

		annotation SummarizationSetBy = Automatic

	column ORDEM_GRUPO
		formatString: 0
		lineageTag: 5ee79166-b625-4087-b89a-82f9dff72876
		summarizeBy: none
		isNameInferred
		sourceColumn: [ORDEM_GRUPO]

		annotation SummarizationSetBy = Automatic

	column GRUPO
		lineageTag: ce6337a1-c20e-4a2c-865b-4f75b4e5c1b4
		summarizeBy: none
		isNameInferred
		sourceColumn: [GRUPO]
		sortByColumn: ORDEM_GRUPO

		annotation SummarizationSetBy = Automatic

	/// RESULTADO = vem da DRE contábil; CONTAS = variação dos saldos das contas da linha; PL = variação do PL menos o resultado.
	column TIPO
		lineageTag: b66d628d-940e-435a-9f38-44e92b39c225
		summarizeBy: none
		isNameInferred
		sourceColumn: [TIPO]

		annotation SummarizationSetBy = Automatic

	partition dEstDFC = calculated
