				        { 6, "OP-FORNECEDORES", "Aumento (redução) de fornecedores", 1, "1. ATIVIDADES OPERACIONAIS", "CONTAS" },
				        { 7, "OP-OBRIGACOES", "Aumento (redução) de obrigações trabalhistas e tributárias", 1, "1. ATIVIDADES OPERACIONAIS", "CONTAS" },
				        { 8, "OP-OUTROS-PASSIVOS", "Aumento (redução) de outros passivos", 1, "1. ATIVIDADES OPERACIONAIS", "CONTAS" },
				        { 9, "INV-ATIVO-NAO-CIRCULANTE", "Imobilizado, intangível e investimentos", 2, "2. ATIVIDADES DE INVESTIMENTO", "CONTAS" },
				        { 10, "FIN-EMPRESTIMOS", "Empréstimos e financiamentos (captação − pagamento)", 3, "3. ATIVIDADES DE FINANCIAMENTO", "CONTAS" },
