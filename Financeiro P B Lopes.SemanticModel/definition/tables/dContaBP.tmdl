	column nivel3
		dataType: string
		lineageTag: 924cba30-dcc2-4684-931c-205c5641828a
		summarizeBy: none
		sourceColumn: nivel3

		annotation SummarizationSetBy = Automatic

	column nivel4
		dataType: string
		lineageTag: 26db4f58-68f1-4eed-a032-80bb5717c53d
		summarizeBy: none
		sourceColumn: nivel4

		annotation SummarizationSetBy = Automatic

	/// Em qual linha da DFC a conta entra (código de dEstDFC). Regra por classe do balanço e por palavras no nome da conta (nível 3, nível 4 e descrição).
	column 'DFC Código' =
			VAR _Txt = UPPER ( dContaBP[nivel3] & " | " & dContaBP[nivel4] & " | " & dContaBP[descricao] )
			VAR _Classe = dContaBP[classe]
			RETURN
			    SWITCH ( TRUE (),
			        dContaBP[eh_disponivel] = 1, "CAIXA",
			        _Classe IN { "PL", "RES" }, "FIN-PATRIMONIO-LIQUIDO",
			        _Classe = "ANC"
			            && ( CONTAINSSTRING ( _Txt, "DEPREC" ) || CONTAINSSTRING ( _Txt, "AMORTIZ" ) || CONTAINSSTRING ( _Txt, "EXAUST" ) ), "OP-DEPRECIACAO",
			        _Classe = "AC" && dContaBP[eh_estoque] = 1, "OP-ESTOQUES",
			        _Classe = "AC"
			            && ( CONTAINSSTRING ( _Txt, "CLIENTE" ) || CONTAINSSTRING ( _Txt, "DUPLICATA" ) || CONTAINSSTRING ( _Txt, "A RECEBER" ) ), "OP-CLIENTES",
			        _Classe = "AC", "OP-OUTROS-ATIVOS",
			        _Classe = "ANC"
			            && ( CONTAINSSTRING ( _Txt, "REALIZ" ) || CONTAINSSTRING ( _Txt, "LONGO PRAZO" ) ), "OP-OUTROS-ATIVOS",
			        _Classe = "ANC", "INV-ATIVO-NAO-CIRCULANTE",
			        CONTAINSSTRING ( _Txt, "EMPREST" ) || CONTAINSSTRING ( _Txt, "EMPRÉST" ) || CONTAINSSTRING ( _Txt, "FINANCIAM" )
			            || CONTAINSSTRING ( _Txt, "ARRENDAM" ) || CONTAINSSTRING ( _Txt, "LEASING" ) || CONTAINSSTRING ( _Txt, "DEBENTURE" )
			            || CONTAINSSTRING ( _Txt, "MUTUO" ) || CONTAINSSTRING ( _Txt, "MÚTUO" ), "FIN-EMPRESTIMOS",
			        CONTAINSSTRING ( _Txt, "FORNEC" ), "OP-FORNECEDORES",
			        CONTAINSSTRING ( _Txt, "TRABALH" ) || CONTAINSSTRING ( _Txt, "SALARI" ) || CONTAINSSTRING ( _Txt, "SALÁRI" )
			            || CONTAINSSTRING ( _Txt, "FERIAS" ) || CONTAINSSTRING ( _Txt, "FÉRIAS" ) || CONTAINSSTRING ( _Txt, "TRIBUT" )
			            || CONTAINSSTRING ( _Txt, "IMPOST" ) || CONTAINSSTRING ( _Txt, "FISCA" ) || CONTAINSSTRING ( _Txt, "SOCIAIS" )
			            || CONTAINSSTRING ( _Txt, "PREVID" ), "OP-OBRIGACOES",
			        "OP-OUTROS-PASSIVOS"
			    )
		dataType: string
		lineageTag: f6221eab-b039-41f3-a04c-1fa6940e4675
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dContaBP = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("192.168.0.234", "pblopes_dts"), "WITH par AS (#(lf)    -- plano de contas, finalidade econômica (moeda) e cenário mais usados no sdo_ctbl#(lf)    SELECT#(lf)        (SELECT cod_plano_cta_ctbl FROM public.sdo_ctbl GROUP BY 1 ORDER BY COUNT(*) DESC LIMIT 1) AS plano,#(lf)        (SELECT cod_finalid_econ   FROM public.sdo_ctbl GROUP BY 1 ORDER BY COUNT(*) DESC LIMIT 1) AS fin,#(lf)        (SELECT cod_cenar_ctbl     FROM public.sdo_ctbl GROUP BY 1 ORDER BY COUNT(*) DESC LIMIT 1) AS cen#(lf)),#(lf)contas AS (#(lf)    SELECT DISTINCT TRIM(s.cod_cta_ctbl) AS cod#(lf)    FROM public.sdo_ctbl s#(lf)    JOIN par p ON s.cod_plano_cta_ctbl = p.plano#(lf)    WHERE NOT EXISTS (SELECT 1 FROM public.estrut_cta_ctbl e#(lf)                      WHERE e.cod_plano_cta_ctbl = p.plano AND TRIM(e.cod_cta_ctbl_pai) = TRIM(s.cod_cta_ctbl))#(lf)),#(lf)nomes AS (#(lf)    SELECT TRIM(c.cod_cta_ctbl) AS cod, MAX(c.des_tit_ctbl) AS nome#(lf)    FROM public.cta_ctbl c JOIN par p ON c.cod_plano_cta_ctbl = p.plano#(lf)    GROUP BY 1#(lf)),#(lf)niveis AS (#(lf)    SELECT k.cod,#(lf)           t.nome AS descricao,#(lf)           COALESCE(n1.nome, m1.nome) AS nivel1,#(lf)           COALESCE(n2.nome, m2.nome) AS nivel2,#(lf)           COALESCE(n3.nome, m3.nome) AS nivel3,#(lf)           COALESCE(n4.nome, m4.nome) AS nivel4#(lf)    FROM contas k#(lf)    LEFT JOIN nomes t  ON t.cod  = k.cod#(lf)    LEFT JOIN nomes n1 ON n1.cod = LEFT(k.cod, 1)#(lf)    LEFT JOIN nomes m1 ON m1.cod = RPAD(LEFT(k.cod, 1), LENGTH(k.cod), '0')#(lf)    LEFT JOIN nomes n2 ON n2.cod = LEFT(k.cod, 2)#(lf)    LEFT JOIN nomes m2 ON m2.cod = RPAD(LEFT(k.cod, 2), LENGTH(k.cod), '0')#(lf)    LEFT JOIN nomes n3 ON n3.cod = LEFT(k.cod, 3)#(lf)    LEFT JOIN nomes m3 ON m3.cod = RPAD(LEFT(k.cod, 3), LENGTH(k.cod), '0')#(lf)    LEFT JOIN nomes n4 ON n4.cod = LEFT(k.cod, 4)#(lf)    LEFT JOIN nomes m4 ON m4.cod = RPAD(LEFT(k.cod, 4), LENGTH(k.cod), '0')#(lf)),#(lf)classif AS (#(lf)    SELECT n.*,#(lf)           CASE WHEN LENGTH(n.cod) = 8#(lf)                THEN SUBSTR(n.cod,1,1)||'.'||SUBSTR(n.cod,2,1)||'.'||SUBSTR(n.cod,3,1)||'.'||SUBSTR(n.cod,4,1)||'.'||SUBSTR(n.cod,5,2)||'.'||SUBSTR(n.cod,7,2)#(lf)                ELSE n.cod END AS conta_formatada,#(lf)           SUBSTR(n.cod,1,1)||'.'||SUBSTR(n.cod,2,1)||'.'||SUBSTR(n.cod,3,1) AS cod3,#(lf)           CASE#(lf)               WHEN LEFT(n.cod,1) = '1' THEN#(lf)                   CASE WHEN UPPER(COALESCE(n.nivel2,'')) LIKE '%N_O CIRC%' THEN 'ANC'#(lf)                        WHEN LEFT(n.cod,2) = '11' THEN 'AC' ELSE 'ANC' END#(lf)               WHEN LEFT(n.cod,1) = '2' THEN#(lf)                   CASE WHEN UPPER(COALESCE(n.nivel2,'')) LIKE '%PATRIM%'   THEN 'PL'#(lf)                        WHEN UPPER(COALESCE(n.nivel2,'')) LIKE '%N_O CIRC%' THEN 'PNC'#(lf)                        WHEN LEFT(n.cod,2) = '21' THEN 'PC'#(lf)                        WHEN LEFT(n.cod,2) = '22' THEN 'PNC'#(lf)                        ELSE 'PL' END#(lf)               ELSE 'RES'#(lf)           END AS classe#(lf)    FROM niveis n#(lf))#(lf)SELECT#(lf)    c.cod AS cod_cta_ctbl,#(lf)    c.conta_formatada,#(lf)    COALESCE(c.descricao, '(sem descrição)') AS descricao,#(lf)    c.conta_formatada || ' - ' || COALESCE(c.descricao, '(sem descrição)') AS conta,#(lf)    CASE WHEN c.classe IN ('AC','ANC') THEN 'ATIVO' ELSE 'PASSIVO E PATRIMÔNIO LÍQUIDO' END AS lado,#(lf)    CASE c.classe WHEN 'AC'  THEN 'ATIVO CIRCULANTE'     WHEN 'ANC' THEN 'ATIVO NÃO CIRCULANTE'#(lf)                  WHEN 'PC'  THEN 'PASSIVO CIRCULANTE'   WHEN 'PNC' THEN 'PASSIVO NÃO CIRCULANTE'#(lf)                  ELSE 'PATRIMÔNIO LÍQUIDO' END AS grupo_bp,#(lf)    CASE c.classe WHEN 'AC' THEN 1 WHEN 'ANC' THEN 2 WHEN 'PC' THEN 3 WHEN 'PNC' THEN 4 ELSE 5 END AS ordem_grupo,#(lf)    CASE WHEN c.classe = 'RES' THEN '9 RESULTADO DO EXERCÍCIO (A APURAR)'#(lf)         ELSE c.cod3 || ' ' || COALESCE(c.nivel3, 'GRUPO ' || c.cod3) END AS subgrupo,#(lf)    c.classe,#(lf)    CASE WHEN c.classe = 'AC' AND (UPPER(COALESCE(c.nivel3,'')) LIKE '%ESTOQUE%' OR UPPER(COALESCE(c.nivel4,'')) LIKE '%ESTOQUE%') THEN 1 ELSE 0 END AS eh_estoque,#(lf)    CASE WHEN c.classe = 'AC' AND (UPPER(COALESCE(c.nivel3,'')) LIKE '%DISPON%' OR UPPER(COALESCE(c.nivel3,'')) LIKE '%CAIXA%') THEN 1 ELSE 0 END AS eh_disponivel,#(lf)    c.nivel1, c.nivel2, c.nivel3, c.nivel4#(lf)FROM classif c")
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

