		lineageTag: ffc86896-0501-4bff-8a70-3c9e0776f237
		summarizeBy: none
		sourceColumn: classe

		annotation SummarizationSetBy = Automatic

	column eh_estoque
		dataType: int64
		formatString: 0
		lineageTag: 062f6cf5-62f3-4959-ace9-ec09c001d5b1
		summarizeBy: none
		sourceColumn: eh_estoque

