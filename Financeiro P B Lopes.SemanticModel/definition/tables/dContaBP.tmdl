	column eh_disponivel
		dataType: int64
		formatString: 0
		lineageTag: 101f5bf0-5a86-4fb5-9c5c-62a5e36a16a8
		summarizeBy: none
		sourceColumn: eh_disponivel

		annotation SummarizationSetBy = Automatic

	column nivel1
		dataType: string
		lineageTag: 1b388fcd-cb30-4eb7-8aba-af6c6329407e
		summarizeBy: none
		sourceColumn: nivel1

		annotation SummarizationSetBy = Automatic

	column nivel2
		dataType: string
		lineageTag: 2d85c671-2886-4cf5-9dbd-0e05b3aaa1ae
		summarizeBy: none
		sourceColumn: nivel2

