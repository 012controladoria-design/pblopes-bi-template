/// Contas analíticas do balanço com grupos (AC, ANC, PC, PNC, PL) e nomes dos níveis do plano de contas do Datasul.
table dContaBP
	lineageTag: 93f7dc9f-b8c0-4450-916a-9942fffbc52b

	column cod_cta_ctbl
		dataType: string
		lineageTag: e6b224b1-0273-4405-937c-dadc6871c0b7
		summarizeBy: none
		sourceColumn: cod_cta_ctbl

		annotation SummarizationSetBy = Automatic

	column conta_formatada
		dataType: string
		lineageTag: 7970891b-78c3-4359-a313-8ba5dbe4a7fe
		summarizeBy: none
		sourceColumn: conta_formatada

