	measure 'CR Recebido Período' = ```
			
			   CALCULATE ( SUM ( fTitulosReceber[valor_original] ),
			       fTitulosReceber[em_aberto] = 0,
			       fTitulosReceber[tipo_especie] <> "Antecipação",
			       USERELATIONSHIP ( dCalendario[Data], fTitulosReceber[data_liquidacao] ) )
			```
		lineageTag: 5b637266-a694-4b9d-89e3-37891abe9a39

	measure 'CR Qtd Clientes com Vencido' =
			
			CALCULATE ( DISTINCTCOUNT ( fTitulosReceber[cod_cliente] ),
			    fTitulosReceber[em_aberto] = 1,
			    fTitulosReceber[tipo_especie] <> "Antecipação",
			    fTitulosReceber[saldo] > 0,
			    fTitulosReceber[Dias em Atraso] > 0 )
		formatString: 0
		lineageTag: ef6a9281-4e67-4136-85fb-9ff2370b7169

	measure 'CR % Top 10 Clientes' =
			
			VAR _Total = CALCULATE ( [CR Carteira], REMOVEFILTERS ( pEmitente[cod_cliente] ) )
			VAR _Tab = ADDCOLUMNS ( ALL ( pEmitente[cod_cliente] ), "ValorCli", [CR Carteira] )
			VAR _Top = TOPN ( 10, _Tab, [ValorCli], DESC )
			RETURN
			    DIVIDE ( SUMX ( _Top, [ValorCli] ), _Total )
		lineageTag: 2c42f0ab-4892-4f3a-b7cf-9517e75055b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Cor Aging' =
			
			IF ( NOT ISINSCOPE ( dCasa[CASA] ), BLANK (),
			VAR _Faixa = SELECTEDVALUE ( fTitulosReceber[Faixa Aging] )
			VAR _Valor = [CR Carteira]
			VAR _Max = MAXX ( ALLSELECTED ( dCasa[CASA] ), [CR Carteira] )
			VAR _p = DIVIDE ( _Valor, _Max )
			RETURN
			    IF ( ISBLANK ( _Valor ) || ISBLANK ( _Faixa ), BLANK (),
			        IF ( _Faixa = "A vencer",
			            SWITCH ( TRUE (), _p > 0.66, "#7DCEA0", _p > 0.33, "#A9DFBF", "#E9F7EF" ),
			            SWITCH ( TRUE (), _p > 0.75, "#E6776A", _p > 0.5, "#F1A89F", _p > 0.25, "#F7CDC8", "#FCECEA" ) ) ) )
		lineageTag: eb28ed49-723d-43dd-bb11-6a0592db2ac0

	measure 'CR Título Top 10' = ```
			
			   "10 maiores clientes · " & FORMAT ( [CR % Top 10 Clientes], "0%" ) & " da carteira"
			```
		lineageTag: a4719611-2116-4293-8b57-66c1d019ff07

	measure 'CR % da Carteira' =
			
