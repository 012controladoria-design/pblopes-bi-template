	measure 'CR % Top 10 Clientes' =
			
			VAR _Total = CALCULATE ( [CR Carteira], REMOVEFILTERS ( pEmitente[cod_cliente] ) )
			VAR _Tab = ADDCOLUMNS ( ALL ( pEmitente[cod_cliente] ), "ValorCli", [CR Carteira] )
			VAR _Top = TOPN ( 10, _Tab, [ValorCli], DESC )
			RETURN
			    DIVIDE ( SUMX ( _Top, [ValorCli] ), _Total )
		lineageTag: 2c42f0ab-4892-4f3a-b7cf-9517e75055b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CR Cor Aging' =
			
			IF ( NOT ISINSCOPE ( dCasa[CASA] ), BLANK (),
			VAR _Faixa = SELECTEDVALUE ( fTitulosReceber[Faixa Aging] )
			VAR _Valor = [CR Carteira]
			VAR _Max = MAXX ( ALLSELECTED ( dCasa[CASA] ), [CR Carteira] )
			VAR _p = DIVIDE ( _Valor, _Max )
			RETURN
			    IF ( ISBLANK ( _Valor ) || ISBLANK ( _Faixa ), BLANK (),
			        IF ( _Faixa = "A vencer",
			            SWITCH ( TRUE (), _p > 0.66, "#7DCEA0", _p > 0.33, "#A9DFBF", "#E9F7EF" ),
			            SWITCH ( TRUE (), _p > 0.75, "#E6776A", _p > 0.5, "#F1A89F", _p > 0.25, "#F7CDC8", "#FCECEA" ) ) ) )
		lineageTag: eb28ed49-723d-43dd-bb11-6a0592db2ac0

