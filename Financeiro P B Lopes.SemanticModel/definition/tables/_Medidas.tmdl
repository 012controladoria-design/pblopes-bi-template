table _Medidas
	lineageTag: b81a728a-9a86-4774-b206-dcb0ccba263a

	measure '001 Realizado' = SUM(fRealizado[VALOR]) + SUM(fAjustesGerenciais[VALOR])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 53dddf5b-38c0-49f5-9a98-23b135a858e4

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '002 DRE Realizado' =
			
			VAR Subtotal = SELECTEDVALUE(dEstDRE[SUBTOTAL])
			VAR OrdemContexto = MAX(dEstDRE[ORDEM])
			VAR RlzContexto = SUM(fRealizado[VALOR]) + sum(fAjustesGerenciais[VALOR]) + SUM(fRlzFinDeprecAmortEstorno[VALOR])
			VAR RlzAcmSubtotal =
			CALCULATE(
			    SUM(fRealizado[VALOR]) + sum(fAjustesGerenciais[VALOR]) +  SUM(fRlzFinDeprecAmortEstorno[VALOR]),
			    FILTER(
			        ALL(dEstDRE),
			        dEstDRE[ORDEM] <= OrdemContexto
			    )
			)
			RETURN
			SWITCH(
			    TRUE(),
			    Subtotal = 0, RlzContexto,
			    Subtotal = 1 && NOT(ISINSCOPE(dPlanoContas[GRUPO])), RlzAcmSubtotal,
			    BLANK()
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Realizado
		lineageTag: 9436e18c-1d2b-47ea-b18f-2d142a5a8122

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '003 A. V. Realizado' =
			
			DIVIDE (
			    [002 DRE Realizado],
			    (
			        CALCULATE (
			            [002 DRE Realizado],
			            FILTER (
			                ALL ( dPlanoContas ),
			                dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS"
			            )
			        )
			            + CALCULATE (
			                [002 DRE Realizado],
			                FILTER ( ALL ( dPlanoContas ), dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			            )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: 24a3f488-0472-4eb5-b0ab-0c11a0a422ef

		changedProperty = FormatString

	measure '018 Realizado até:' =
			
			VAR MaiorDataRlz =
			    CALCULATE ( MAX ( fRealizado[DATA] ), ALL ( fRealizado ) )
			VAR Mes =
			    FORMAT ( MaiorDataRlz, "MMMM" )
			RETURN
			    "* Valores realizados até " & Mes & "/"
			        & YEAR ( MaiorDataRlz )
			        & ". Para vendas diretas de Maringá, considera-se o valor de comissão recebido da Scania (20% da venda)."
		displayFolder: Realizado
		lineageTag: e211ca9f-3f1d-43bd-90ac-fb53de87d50f

	measure 'CR Carteira' =
			
			CALCULATE ( SUM ( fTitulosReceber[saldo] ),
			    fTitulosReceber[em_aberto] = 1,
			    fTitulosReceber[tipo_especie] <> "Antecipação" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: a18788c2-091b-4e40-ab8c-039120032984

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'CR Qtd Títulos' =
			
			CALCULATE ( COUNTROWS ( fTitulosReceber ),
			    fTitulosReceber[em_aberto] = 1,
			    fTitulosReceber[tipo_especie] <> "Antecipação",
			    fTitulosReceber[saldo] > 0 )
		formatString: 0
		lineageTag: ea6c0626-e57d-4fd8-9900-48403e8c6acd

	measure 'CR Vencido' = CALCULATE ( [CR Carteira], fTitulosReceber[Dias em Atraso] > 0 )
