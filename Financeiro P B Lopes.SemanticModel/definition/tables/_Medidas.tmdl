	measure '003 A. V. Orçado' =
			
			DIVIDE (
			    [002 DRE Orçado],
			    (
			        CALCULATE (
			            [002 DRE Orçado],
			            FILTER (
			                ALL ( dPlanoContas ),
			                dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS"
			            )
			        )
			            + CALCULATE (
			                [002 DRE Orçado],
			                FILTER ( ALL ( dPlanoContas ), dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			            )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
