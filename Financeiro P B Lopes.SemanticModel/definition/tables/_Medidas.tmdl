		displayFolder: Realizado
		lineageTag: 32a8e626-49f1-4248-a669-f925c91b282b

		changedProperty = FormatString

	measure '044 Result Op. Líquido Mesmo Período Ano Anterior Rlz' =
			
			CALCULATE (
			    [040 DRE Rlz Mesmo Período Ano Anterior],
			    FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" )
			)
			    + CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			    )
			    + CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) IMPOSTOS SOBRE AS VENDAS"
			        )
			    )
			    + CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) CUSTOS DAS VENDAS E SERVICOS"
			        )
			    )
			    + CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" )
			    )
			    + CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS"
			        )
			    )
			    - CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[CONTA_CONTABIL] = "5.1.1.2.00.01- DEPRECIACOES"
			        )
			    )
			    - CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[CONTA_CONTABIL] = "5.1.1.2.00.05- AMORTIZAÇÃO"
			        )
			    )
			    - CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[CONTA_CONTABIL] = "5.1.2.2.00.02- DEPRECIAÇÃO"
			        )
			    )
			    - CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[CONTA_CONTABIL] = "5.1.2.2.00.05- AMORTIZAÇÃO"
			        )
			    )
			    - CALCULATE (
			        [040 DRE Rlz Mesmo Período Ano Anterior],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) DEPREC / AMORT CUSTO" )
			    )
