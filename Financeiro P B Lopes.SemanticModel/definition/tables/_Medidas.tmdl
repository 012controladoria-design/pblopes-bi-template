	measure '013 Resultado Op. Líquido Total Rlz' = CALCULATE([002 DRE Realizado], ALLSELECTED(dCasa))
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 01d4ce56-2ed5-44d0-bf63-9b5a4b3c3938

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '012 Resultado Op. Líquido Acm Rlz' =
			
			VAR RankResultCasas =
			    RANKX ( ALLSELECTED ( dCasa ), [002 DRE Realizado] )
			RETURN
			    CALCULATE (
			        [002 DRE Realizado],
			        TOPN ( RankResultCasas, ALLSELECTED ( dcasa ), [002 DRE Realizado], DESC )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 5f2477fb-ced0-416a-b885-bb990a613c69

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '014 % Resultado Op. Líquido Rlz' = DIVIDE([002 DRE Realizado],[013 Resultado Op. Líquido Total Rlz])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: 929998c8-29e5-490d-9143-ccc530f25199

		changedProperty = FormatString

	measure '015 % Resultado Op. Líquido Acm Rlz' = DIVIDE([012 Resultado Op. Líquido Acm Rlz],[013 Resultado Op. Líquido Total Rlz])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: c2eb31dc-1be2-4b65-b5fa-660d026efb2c

		changedProperty = FormatString

	measure '016 % ABS Filiais Realizado' = ```
			
			VAR ResultBrutoPecas = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[COD_CONTA_CONTABIL] = "3.1.3.1.00.10" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "3.1.3.1.00.11" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.03" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.04" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.07" || 
			    dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.08" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.09" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.15" ||
			    dPlanoContas[GRUPO] = "DEVOLUCOES" ||
			    dPlanoContas[GRUPO] = "IMPOSTOS SOBRE AS VENDAS" ||
			    dPlanoContas[GRUPO] = "VENDAS DE MERCAD.E SERVICOS" ||
			    dPlanoContas[SUB_GRUPO] = "CUSTOS VDAS.MERCADORIAS",
			    dCentroCusto[SETOR] = "PECAS")
			    
			
			VAR ResultBrutoAssistTec = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.2.00.02" || 
			    dPlanoContas[COD_CONTA_CONTABIL] = "4.1.2.1.00.01" || 
			    dPlanoContas[GRUPO] = "DEVOLUCOES" ||
			    dPlanoContas[GRUPO] = "IMPOSTOS SOBRE AS VENDAS",
			    dCentroCusto[SETOR] = "OFICINA" ||
			    dCentroCusto[SETOR] = "REFORMADORA")
			
			VAR DespComerciais = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[GRUPO] = "DESPESAS COM A COMERCIALIZACAO",
			    dCentroCusto[SETOR] = "PECAS" ||
			    dCentroCusto[SETOR] = "OFICINA" ||
			    dCentroCusto[SETOR] = "REFORMADORA" ||
			    dCentroCusto[SETOR] = "ALINHAMENTO",
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.01")
			
			VAR DespAdm = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[GRUPO] = "DESPESAS ADMINISTRATIVAS" ||
			    dPlanoContas[GRUPO] = "VENDAS DE MERCAD.E SERVICOS" ||
			    dPlanoContas[GRUPO] = "OUTRAS RECEITAS OPERACIONAIS LIQUIDAS" ||
			    dPlanoContas[GRUPO] = "DEVOLUCOES" ||
			    dPlanoContas[GRUPO] = "IMPOSTOS SOBRE AS VENDAS",  
			    dCentroCusto[SETOR] = "ADM",
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.2.2.00.02" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "3.1.3.1.00.XX")
			    
			
			VAR OutrasRecOpLiqPecas = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[GRUPO] = "OUTRAS RECEITAS OPERACIONAIS LIQUIDAS" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "3.1.3.1.00.10" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "3.1.3.1.00.11" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.4.1.00.03" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.4.1.00.04" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.4.1.00.07" && 
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.4.1.00.08" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.4.1.00.09" &&
			    dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.4.1.00.15",
			    dCentroCusto[SETOR] = "PECAS")
			
			VAR OutrasRecOpLiqAssistTec = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[GRUPO] = "OUTRAS RECEITAS OPERACIONAIS LIQUIDAS",
			    dCentroCusto[SETOR] = "OFICINA" ||
			    dCentroCusto[SETOR] = "REFORMADORA")
			    
			VAR DeprecAssistTec = 
			CALCULATE(
			    [001 Realizado],
			    dPlanoContas[COD_CONTA_CONTABIL] = "8.0.2.0.00.10" ||
			    dPlanoContas[COD_CONTA_CONTABIL] = "8.0.3.0.00.10")*-1
			
			RETURN
			   DIVIDE(ResultBrutoPecas + ResultBrutoAssistTec, DespComerciais + DespAdm + OutrasRecOpLiqPecas + OutrasRecOpLiqAssistTec + DeprecAssistTec)*-1
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: Realizado
		lineageTag: 3c3dc06f-3840-45af-afa0-4fa97934ca74

		changedProperty = FormatString

