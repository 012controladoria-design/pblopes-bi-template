	measure '041 AV Rlz Mesmo Período Anterior' =
			
			DIVIDE (
			    [040 DRE Rlz Mesmo Período Ano Anterior],
			    (
			        CALCULATE (
			            [040 DRE Rlz Mesmo Período Ano Anterior],
			            FILTER (
			                ALL ( dPlanoContas ),
			                dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS"
			            )
			        )
			            + CALCULATE (
			                [040 DRE Rlz Mesmo Período Ano Anterior],
			                FILTER ( ALL ( dPlanoContas ), dPlanoContas[SUB_GRUPO] = "DEVOLUCOES" )
			            )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
