		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '008 % Margem Operacional Bruta Orç' = DIVIDE([007 Resultado Operacional Bruto Orç], [005 Receita Operacional Bruta Orç])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Orçado
		lineageTag: 7d80a257-f5d1-4008-8ac9-7cda187ff827

		changedProperty = FormatString

	measure '009 Resultado Operacional Orç' =
			
			CALCULATE (
			    [002 DRE Orçado],
			    FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" )
			)
			    + CALCULATE (
			        [002 DRE Orçado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			    )
			    + CALCULATE (
			        [002 DRE Orçado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) IMPOSTOS SOBRE AS VENDAS"
			        )
			    )
			    + CALCULATE (
			        [002 DRE Orçado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) CUSTOS DAS VENDAS E SERVICOS"
			        )
			    )
			    + CALCULATE (
			        [002 DRE Orçado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" )
			    )
			    + CALCULATE (
			        [002 DRE Orçado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+/-) RECEITAS FINANCEIRAS" )
			    )
			    + CALCULATE (
			        [002 DRE Orçado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS"
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Orçado
		lineageTag: 6be3d25c-e41c-4ac7-b8ca-fb226861fd39

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '010 % Margem Operacional Orç' = DIVIDE([009 Resultado Operacional Orç], [005 Receita Operacional Bruta Orç])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Orçado
		lineageTag: 0a6c54b6-e4f6-4ace-b420-55a3eff0fb6e

		changedProperty = FormatString

	measure '011 A. H. DRE Rlz x Orç' = [002 DRE Realizado] - [002 DRE Orçado]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Orçado
