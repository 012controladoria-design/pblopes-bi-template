	measure '007 ROE' =
			
			Var Lucro_Liquido = [001 Realizado]
			Var Patrimonio_Liquido = CALCULATE(sum(f_Dados_BP_Rlz[VALOR]), f_Dados_BP_Rlz[GRUPO] = "PATRIMONIO LIQUIDO")
			Var Parcial = DIVIDE(Lucro_Liquido * 0.65, 9)*12
			
			RETURN
			DIVIDE(Parcial, Patrimonio_Liquido)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Dados_BP
		lineageTag: 6c996081-72f5-442c-bd05-12cef61f0abf

	measure '008 ILC' = DIVIDE([001 Ativo Circulante], [002 Passivo Circulante])
