		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '043 % AH Atual x Anterior Rlz' =
			
			DIVIDE (
			    [042 AH Atual x Anterior Rlz],
			    ABS ( [040 DRE Rlz Mesmo Período Ano Anterior] )
			)
