	measure 'CR Qtd Clientes com Vencido' =
			
			CALCULATE ( DISTINCTCOUNT ( fTitulosReceber[cod_cliente] ),
			    fTitulosReceber[em_aberto] = 1,
			    fTitulosReceber[tipo_especie] <> "Antecipação",
			    fTitulosReceber[saldo] > 0,
			    fTitulosReceber[Dias em Atraso] > 0 )
		formatString: 0
