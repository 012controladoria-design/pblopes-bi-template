	measure '040 DRE Rlz Mesmo Período Ano Anterior' = CALCULATE([002 DRE Realizado],SAMEPERIODLASTYEAR(aCalendario[Data]))
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
