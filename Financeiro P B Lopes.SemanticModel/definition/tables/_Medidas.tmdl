	measure '020 DRE Orç Mesmo Período Ano Anterior' = CALCULATE([002 DRE Orçado],SAMEPERIODLASTYEAR(aCalendario[Data]))
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Orçado
