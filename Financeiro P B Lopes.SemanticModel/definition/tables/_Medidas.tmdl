		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '031 Resultado Líq. ADM Filiais s/ Top Dealer Rlz' =
			
			CALCULATE (
			    [002 DRE Realizado],
			    dCentroCusto[SETOR] = "ADM",
			    dCasa[COD_CASA] <> "101",
			    dPlanoContas[CONTA_CONTABIL] <> "3.1.3.1.00.XX- TOP DEALER"
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 2ca767c1-20a9-41e7-ab5d-12c910cd5452

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '017 % ABS Scania Realizado' = ```
			
			VAR ReceitaLiquidaPecas = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.1.00.02" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.1.00.04" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.1.00.05" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.3.1.00.10" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.3.1.00.11" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.2.00.01" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.2.1.1.00.01",
			        dCentroCusto[SETOR] = "PECAS",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20400"
			    )
			
			VAR ReceitaLiquidaServicos = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.2.00.01" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "3.1.1.2.00.02",
			        dCentroCusto[SETOR] = "OFICINA" ||
			        dCentroCusto[SETOR] = "REFORMADORA" ||
			        dCentroCusto[SETOR] = "MOTORES",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20306"
			    )
			
			VAR ImpostosPecas = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO] = "IMPOSTOS SOBRE AS VENDAS",
			        dCentroCusto[SETOR] = "PECAS",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20400"
			    )
			
			VAR ImpostosServicos = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO] = "IMPOSTOS SOBRE AS VENDAS",
			        dCentroCusto[SETOR] = "OFICINA" ||
			        dCentroCusto[SETOR] = "REFORMADORA" ||
			        dCentroCusto[SETOR] = "MOTORES",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20306"
			    )
			
			VAR CustosPecas = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[COD_CONTA_CONTABIL] = "4.1.1.1.00.02" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "4.1.1.1.00.04" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "4.1.1.1.00.07" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.03" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "5.1.4.1.00.04",
			        dCentroCusto[SETOR] = "PECAS",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20400"
			    )
			
			VAR CustosServicos = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[SUB_GRUPO] = "CUSTO VDAS. DE SERVICOS",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20306"
			    )
			
			
			VAR DepreciacaoServicos = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[COD_CONTA_CONTABIL] = "8.0.2.0.00.09" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "8.0.2.0.00.10" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "8.0.3.0.00.09" ||
			        dPlanoContas[COD_CONTA_CONTABIL] = "8.0.3.0.00.10"
			    )
			
			VAR DespesasCaminhoes = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS",
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.01" &&
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.05",
			        dCentroCusto[COD_CENTRO_CUSTO] = "20101" ||
			        dCentroCusto[COD_CENTRO_CUSTO] = "20105"
			    )
			
			VAR DespesasOnibus = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS",
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.01" &&
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.05",
			        dCentroCusto[COD_CENTRO_CUSTO] = "20102"
			    )
			
			VAR DespesasUsados = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS",
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.01" &&
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.05",
			        dCentroCusto[COD_CENTRO_CUSTO] = "20103"
			    )
			
			VAR DespesasPecas = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS",
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.01" &&
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.05",
			        dCentroCusto[SETOR] = "PECAS",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20400"
			    )
			
			VAR DespesasServicos = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS",
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.01" &&
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.1.2.00.05",
			        dCentroCusto[SETOR] = "OFICINA" ||
			        dCentroCusto[SETOR] = "REFORMADORA",
			        dCentroCusto[COD_CENTRO_CUSTO] <> "20306"
			    )
			
			VAR DespesasAdministrativo = 
			    CALCULATE(
			        [001 Realizado],
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS",
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.2.2.00.02" &&
			        dPlanoContas[COD_CONTA_CONTABIL] <> "5.1.2.2.00.05",
			        dCentroCusto[SETOR] = "ADM"
			    )
			
			VAR LucroBruto = 
			    ReceitaLiquidaPecas + ReceitaLiquidaServicos + ImpostosPecas + ImpostosServicos + CustosPecas + 
			    CustosServicos + DepreciacaoServicos
			
			VAR DespesasGerais = 
			    DespesasAdministrativo + DespesasCaminhoes + DespesasPecas + DespesasServicos + DespesasOnibus + DespesasUsados
			
			RETURN
			divide(LucroBruto,DespesasGerais) * -1
			
			```
