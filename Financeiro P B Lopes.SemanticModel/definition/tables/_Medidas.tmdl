	measure '048 Ebit RLZ' =
			
			CALCULATE (
			    [002 DRE Realizado],
			        dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" ||
			        dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" ||
			        dPlanoContas[GRUPO_DRE] = "(-) IMPOSTOS SOBRE AS VENDAS" ||
			        dPlanoContas[GRUPO_DRE] = "(-) CUSTOS DAS VENDAS E SERVICOS" ||
			        dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" ||
			        dPlanoContas[GRUPO_DRE] = "(+) ESTORNO DEPREC / AMORT CUSTO" ||
			        dPlanoContas[GRUPO_DRE] = "(+) ESTORNO DEPRECIACOES / AMORTIZACOES DESPESAS"
			)
			
			/* - CALCULATE(
			    [002 DRE Realizado],
			        dPlanoContas[CONTA_CONTABIL] = "3.1.3.1.00.10- RECEITAS DE GARANTIA" ||
			        dPlanoContas[CONTA_CONTABIL] = "3.1.3.1.00.11- RECEITAS DE REVISÃO" ||
			        dPlanoContas[CONTA_CONTABIL] = "5.1.4.1.00.08- PIS S/ GARANTIAS E REVISOES -" ||
			        dPlanoContas[CONTA_CONTABIL] = "5.1.4.1.00.09- COFINS S/ GARANTIAS E REVISOES" ||
			        dPlanoContas[CONTA_CONTABIL] = "5.1.4.1.00.15- ICMS S/ REPOS.GARANTIA E REVIS." ||
			        dPlanoContas[CONTA_CONTABIL] = "5.1.4.1.00.03- REPOSICAO EM GARANTIAS" ||
			        dPlanoContas[CONTA_CONTABIL] = "5.1.4.1.00.04- DESPESAS COM REVISOES"
			) */
		displayFolder: Realizado
		lineageTag: b36ace05-2024-4497-bc30-4f69a07f0aca

