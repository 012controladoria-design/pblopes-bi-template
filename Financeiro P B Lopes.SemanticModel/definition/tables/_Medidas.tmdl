	measure '018 Realizado até:' =
			
			VAR MaiorDataRlz =
			    CALCULATE ( MAX ( fRealizado[DATA] ), ALL ( fRealizado ) )
			VAR Mes =
			    FORMAT ( MaiorDataRlz, "MMMM" )
			RETURN
			    "* Valores realizados até " & Mes & "/"
			        & YEAR ( MaiorDataRlz )
			        & ". Para vendas diretas de Maringá, considera-se o valor de comissão recebido da Scania (20% da venda)."
		displayFolder: Realizado
		lineageTag: e211ca9f-3f1d-43bd-90ac-fb53de87d50f

	measure '001 Orçado' =
			
			SWITCH (
			    TRUE (),
			    [000 Tipo Orçado Selecionado] = "ORÇADO PROJEÇÃO", SUM (fOrcadoProjecao[VALOR]),
			    [000 Tipo Orçado Selecionado] = "ORÇADO RTM", SUM (fOrcado[VALOR]),
			    [000 Tipo Orçado Selecionado] = "ORÇADO RTM", SUM (fOrcadoProjecao500[VALOR]),
			    SUM (fOrcado[VALOR])
			)
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Orçado
		lineageTag: a1f6953b-b363-40c7-8a12-e00881939d6d

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '002 DRE Orçado' = ```
			
			VAR Subtotal = SELECTEDVALUE(dEstDRE[SUBTOTAL])
			VAR OrdemContexto = MAX(dEstDRE[ORDEM])
			VAR RlzContexto = 
			SWITCH (
			    TRUE (),
			    [000 Tipo Orçado Selecionado] = "ORÇADO PROJEÇÃO", SUM(fOrcadoProjecao[VALOR]) + SUM(fOrcProjecaoFinEstorno[VALOR]),
			    [000 Tipo Orçado Selecionado] = "ORÇADO RTM", SUM(fOrcado[VALOR]) + SUM(fOrcFinEstorno[VALOR]),
			    [000 Tipo Orçado Selecionado] = "ORÇADO PROJEÇÃO 500", SUM(fOrcadoProjecao500[VALOR]) + SUM(fOrcProjecaoFinEstorno500[VALOR]),
			    SUM(fOrcado[VALOR]) + SUM(fOrcFinEstorno[VALOR])
			)
			VAR RlzAcmSubtotal =
			CALCULATE(
			    SWITCH (
			    TRUE (),
			    [000 Tipo Orçado Selecionado] = "ORÇADO PROJEÇÃO", SUM(fOrcadoProjecao[VALOR]) + SUM(fOrcProjecaoFinEstorno[VALOR]),
			    [000 Tipo Orçado Selecionado] = "ORÇADO RTM", SUM(fOrcado[VALOR]) + SUM(fOrcFinEstorno[VALOR]),
			    [000 Tipo Orçado Selecionado] = "ORÇADO PROJEÇÃO 500", SUM(fOrcadoProjecao500[VALOR]) + SUM(fOrcProjecaoFinEstorno500[VALOR]),
			    SUM(fOrcado[VALOR]) + SUM(fOrcFinEstorno[VALOR])
			),
			    FILTER(
			        ALL(dEstDRE),
			        dEstDRE[ORDEM] <= OrdemContexto
			    )
			)
			RETURN
			SWITCH(
			    TRUE(),
			    Subtotal = 0, RlzContexto,
			    Subtotal = 1 && NOT(ISINSCOPE(dPlanoContas[GRUPO])), RlzAcmSubtotal,
			    BLANK()
			)
			```
		displayFolder: Orçado
		lineageTag: 04a4711b-095a-4f28-95a2-ceb6756d633d

