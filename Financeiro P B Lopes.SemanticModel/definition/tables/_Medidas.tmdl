	measure '042 AH Atual x Anterior Rlz' = [002 DRE Realizado] - [040 DRE Rlz Mesmo Período Ano Anterior]
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
