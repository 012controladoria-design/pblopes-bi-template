table _Medidas
	lineageTag: b81a728a-9a86-4774-b206-dcb0ccba263a

	measure '001 Realizado' = SUM(fRealizado[VALOR]) + SUM(fAjustesGerenciais[VALOR])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 53dddf5b-38c0-49f5-9a98-23b135a858e4

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '002 DRE Realizado' =
			
			VAR Subtotal = SELECTEDVALUE(dEstDRE[SUBTOTAL])
			VAR OrdemContexto = MAX(dEstDRE[ORDEM])
			VAR RlzContexto = SUM(fRealizado[VALOR]) + sum(fAjustesGerenciais[VALOR]) + SUM(fRlzFinDeprecAmortEstorno[VALOR])
			VAR RlzAcmSubtotal =
			CALCULATE(
			    SUM(fRealizado[VALOR]) + sum(fAjustesGerenciais[VALOR]) +  SUM(fRlzFinDeprecAmortEstorno[VALOR]),
			    FILTER(
			        ALL(dEstDRE),
			        dEstDRE[ORDEM] <= OrdemContexto
			    )
			)
			RETURN
			SWITCH(
			    TRUE(),
			    Subtotal = 0, RlzContexto,
			    Subtotal = 1 && NOT(ISINSCOPE(dPlanoContas[GRUPO])), RlzAcmSubtotal,
			    BLANK()
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Realizado
		lineageTag: 9436e18c-1d2b-47ea-b18f-2d142a5a8122

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '003 A. V. Realizado' =
			
			DIVIDE (
			    [002 DRE Realizado],
			    (
			        CALCULATE (
			            [002 DRE Realizado],
			            FILTER (
			                ALL ( dPlanoContas ),
			                dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS"
			            )
			        )
			            + CALCULATE (
			                [002 DRE Realizado],
			                FILTER ( ALL ( dPlanoContas ), dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			            )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: 24a3f488-0472-4eb5-b0ab-0c11a0a422ef

		changedProperty = FormatString

	measure '007 Resultado Operacional Bruto Rlz' =
			
			CALCULATE (
			    [002 DRE Realizado],
			    FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" )
			)
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) IMPOSTOS SOBRE AS VENDAS"
			        )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) CUSTOS DAS VENDAS E SERVICOS"
			        )
			    )
		displayFolder: Realizado
		lineageTag: e8b0c987-b4d0-4600-b9ce-57e5ef52a91b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '008 % Margem Operacional Bruta Rlz' = DIVIDE([007 Resultado Operacional Bruto Rlz], [005 Receita Operacional Bruta Rlz])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: 868bee21-299a-4c11-9d1f-2153290597da

	measure '005 Receita Operacional Bruta Rlz' =
			
			CALCULATE (
			    [002 DRE Realizado],
			    FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" )
			)
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 069c6fcb-329d-4b33-b5c8-253ef62a2dc9

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '006 Receita Operacional Líquida Rlz' =
			
			CALCULATE (
			    [002 DRE Realizado],
			    FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" )
			)
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) IMPOSTOS SOBRE AS VENDAS"
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 8c057f45-129a-4873-8c85-2f85306c0cd5

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '009 Resultado Operacional Rlz' =
			
			CALCULATE (
			    [002 DRE Realizado],
			    FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS" )
			)
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DEVOLUCOES" )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) IMPOSTOS SOBRE AS VENDAS"
			        )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(-) CUSTOS DAS VENDAS E SERVICOS"
			        )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(-) DESPESAS OPERACIONAIS" )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER ( dPlanoContas, dPlanoContas[GRUPO_DRE] = "(+/-) RECEITAS FINANCEIRAS" )
			    )
			    + CALCULATE (
			        [002 DRE Realizado],
			        FILTER (
			            dPlanoContas,
			            dPlanoContas[GRUPO_DRE] = "(+/-) OUTRAS RECEITAS OPERACIONAIS"
			        )
			    )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: 9bc390e4-b453-4306-8246-b286fbca8e8b

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '010 % Margem Operacional Rlz' = DIVIDE([009 Resultado Operacional Rlz], [005 Receita Operacional Bruta Rlz])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: c64723ca-31dc-4b0f-80e5-475d2e3f73d7

		changedProperty = FormatString

	measure '004 ABS Reallizado' = ABS([001 Realizado])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Realizado
		lineageTag: d0a9a8fa-2750-4d70-b08e-ea2544f79034

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure '011 AV Absoluto Rlz' = [003 A. V. Realizado] * -1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Realizado
		lineageTag: 89be68bf-2450-40dd-8b3d-ae10e3cc38eb

