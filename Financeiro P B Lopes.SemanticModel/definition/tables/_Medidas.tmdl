	measure '021 AV Orç Mesmo Período Anterior' =
			
			DIVIDE (
			    [020 DRE Orç Mesmo Período Ano Anterior],
			    (
			        CALCULATE (
			            [020 DRE Orç Mesmo Período Ano Anterior],
			            FILTER (
			                ALL ( dPlanoContas ),
			                dPlanoContas[GRUPO_DRE] = "(+) RECEITA COM VENDAS"
			            )
			        )
			            + CALCULATE (
			                [020 DRE Orç Mesmo Período Ano Anterior],
			                FILTER ( ALL ( dPlanoContas ), dPlanoContas[SUB_GRUPO] = "DEVOLUCOES" )
			            )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
