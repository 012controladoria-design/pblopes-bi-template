	column em_aberto
		dataType: int64
		formatString: 0
		lineageTag: 11e7f3ab-7a9d-4105-ab2c-77fae9de1165
		summarizeBy: none
		sourceColumn: em_aberto

		annotation SummarizationSetBy = Automatic

	column 'Dias em Atraso' =
			
			IF ( fTitulosPagar[em_aberto] = 1, INT ( TODAY () - fTitulosPagar[data_vencimento] ) )
		formatString: 0
		lineageTag: 400174de-62a5-44f3-b210-f6ca234e53b0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Faixa Aging' =
			
			VAR d = fTitulosPagar[Dias em Atraso]
			RETURN
			    IF ( fTitulosPagar[em_aberto] = 1,
			        SWITCH ( TRUE (),
			            d <= 0,   "A vencer",
			            d <= 30,  "Vencido 1-30",
			            d <= 60,  "Vencido 31-60",
			            d <= 90,  "Vencido 61-90",
			            d <= 180, "Vencido 91-180",
			            d <= 365, "Vencido 181-365",
			                      "Vencido +365" ) )
		lineageTag: 0aada053-564c-49f6-8ec3-effb8c22b154
		summarizeBy: none
		sortByColumn: 'Faixa Aging Ordem'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Faixa Aging Ordem' =
			
			VAR _d = fTitulosPagar[Dias em Atraso]
			RETURN
			    SWITCH ( TRUE (),
			        _d <= 0, 0,
			        _d <= 30, 1,
			        _d <= 60, 2,
			        _d <= 90, 3,
			        _d <= 180, 4,
			        _d <= 365, 5,
			        6 )
		formatString: 0
		lineageTag: 97bf9b83-17ef-4e53-8446-f948d5a8159d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fTitulosPagar = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("192.168.0.234", "pblopes_dts"), "SELECT#(lf)    t.num_id_tit_ap                         AS id_titulo,#(lf)    t.cod_estab                             AS cod_estab,#(lf)    t.cod_espec_docto                       AS especie,#(lf)    t.ind_tip_espec_docto                   AS tipo_especie,#(lf)    t.cod_ser_docto                         AS serie,#(lf)    t.cod_tit_ap                            AS titulo,#(lf)    t.cod_parcela                           AS parcela,#(lf)    t.cdn_fornecedor                        AS cod_fornecedor,#(lf)    t.cod_portador                          AS cod_portador,#(lf)    t.ind_origin_tit_ap                     AS origem,#(lf)    t.ind_sit_tit_ap                        AS situacao,#(lf)    t.dat_emis_docto                        AS data_emissao,#(lf)    t.dat_vencto_tit_ap                     AS data_vencimento,#(lf)    t.dat_prev_pagto                        AS data_prev_pagamento,#(lf)    CASE WHEN t.dat_liquidac_tit_ap >= DATE '9999-01-01' THEN NULL#(lf)         ELSE t.dat_liquidac_tit_ap END     AS data_liquidacao,#(lf)    t.val_origin_tit_ap                     AS valor_original,#(lf)    t.val_sdo_tit_ap                        AS saldo,#(lf)    t.val_juros                             AS juros,#(lf)    t.val_desc_tit_ap                       AS desconto,#(lf)    t.val_abat_tit_ap                       AS abatimento,#(lf)    CAST(t.log_pagto_bloqdo AS int)         AS pagto_bloqueado,#(lf)    CAST(t.log_sdo_tit_ap AS int)           AS em_aberto#(lf)FROM public.tit_ap t#(lf)WHERE t.num_id_tit_ap IS NOT NULL#(lf)  AND CAST(t.log_tit_ap_estordo AS int) = 0       -- tira os títulos estornados", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

