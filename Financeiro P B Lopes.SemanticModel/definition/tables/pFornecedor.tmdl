	partition pFornecedor = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("192.168.0.234", "pblopes_dts"), "SELECT#(lf)    e.cod_emitente   AS cod_fornecedor,#(lf)    e.nome_abrev     AS fornecedor_abrev,#(lf)    e.nome_emit      AS fornecedor,#(lf)    e.cgc            AS cnpj_cpf,#(lf)    e.cidade,#(lf)    e.estado         AS uf#(lf)FROM public.emitente e#(lf)WHERE e.cod_emitente IN (SELECT DISTINCT cdn_fornecedor FROM public.tit_ap)", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

