	partition pEmitente = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("192.168.0.234", "pblopes_dts"), "SELECT#(lf)    e.cod_emitente   AS cod_cliente,#(lf)    e.nome_abrev     AS cliente_abrev,#(lf)    e.nome_emit      AS cliente,#(lf)    e.cgc            AS cnpj_cpf,#(lf)    CASE e.natureza WHEN 1 THEN 'Pessoa física'  WHEN 2 THEN 'Pessoa jurídica'#(lf)                    WHEN 3 THEN 'Estrangeiro'    WHEN 4 THEN 'Trading' END AS natureza,#(lf)    e.cidade,#(lf)    e.estado         AS uf,#(lf)    e.cod_gr_cli     AS grupo_cliente#(lf)FROM public.emitente e#(lf)WHERE e.cod_emitente IN (SELECT DISTINCT cdn_cliente FROM public.tit_acr)", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

