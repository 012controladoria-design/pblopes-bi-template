	column em_aberto
		dataType: int64
		formatString: 0
		lineageTag: a186d9ac-d56d-4deb-b789-88b6ea70b73b
		summarizeBy: sum
		sourceColumn: em_aberto

		annotation SummarizationSetBy = Automatic

	column 'Dias em Atraso' =
			
			IF ( fTitulosReceber[em_aberto] = 1, INT ( TODAY () - fTitulosReceber[data_vencimento] ) )
		formatString: 0
		lineageTag: 6f2e9b33-ef96-4051-a66d-5571299d3e56
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Faixa Aging' =
			
			VAR d = fTitulosReceber[Dias em Atraso]
			RETURN
			    IF ( fTitulosReceber[em_aberto] = 1,
			        SWITCH ( TRUE (),
			            d <= 0,   "A vencer",
			            d <= 30,  "Vencido 1-30",
			            d <= 60,  "Vencido 31-60",
			            d <= 90,  "Vencido 61-90",
			            d <= 180, "Vencido 91-180",
			            d <= 365, "Vencido 181-365",
			                      "Vencido +365" ) )
		lineageTag: bf3d5026-e4a7-4b99-9822-71b5bbe200d6
		summarizeBy: none
		sortByColumn: 'Faixa Aging Ordem'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Ordem Aging' =
			
			SWITCH ( fTitulosReceber[Faixa Aging],
			    "A vencer", 1, "Vencido 1-30", 2, "Vencido 31-60", 3, "Vencido 61-90", 4,
			    "Vencido 91-180", 5, "Vencido 181-365", 6, "Vencido +365", 7 )
		formatString: 0
		lineageTag: 9b0ebde1-1e42-4d17-a0ca-0f7e91765c53
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Faixa Aging Ordem' =
			
			VAR _d = fTitulosReceber[Dias em Atraso]
			RETURN
			    SWITCH ( TRUE (),
			        _d <= 0, 0,
			        _d <= 30, 1,
			        _d <= 60, 2,
			        _d <= 90, 3,
			        _d <= 180, 4,
			        _d <= 365, 5,
			        6 )
		formatString: 0
		lineageTag: 998df738-38b4-4c82-9639-f82b544d4eba
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition fTitulosReceber = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database("192.168.0.234", "pblopes_dts"), "SELECT#(lf)    t.num_id_tit_acr                        AS id_titulo,#(lf)    t.cod_estab                             AS cod_estab,#(lf)    t.cod_espec_docto                       AS especie,#(lf)    t.ind_tip_espec_docto                   AS tipo_especie,#(lf)    t.cod_ser_docto                         AS serie,#(lf)    t.cod_tit_acr                           AS titulo,#(lf)    t.cod_parcela                           AS parcela,#(lf)    t.cdn_cliente                           AS cod_cliente,#(lf)    t.cdn_repres                            AS cod_repres,#(lf)    t.cod_portador                          AS cod_portador,#(lf)    t.cod_cart_bcia                         AS carteira,#(lf)    t.ind_orig_tit_acr                      AS origem,#(lf)    t.ind_sit_bcia_tit_acr                  AS situacao_bancaria,#(lf)    t.cod_nota_fisc_faturam                 AS nota_fiscal,#(lf)    t.dat_emis_docto                        AS data_emissao,#(lf)    t.dat_vencto_tit_acr                    AS data_vencimento,#(lf)    t.dat_vencto_origin_tit_acr             AS data_vencimento_original,#(lf)    CASE WHEN t.dat_liquidac_tit_acr >= DATE '9999-01-01' THEN NULL#(lf)         ELSE t.dat_liquidac_tit_acr END    AS data_liquidacao,#(lf)    t.val_origin_tit_acr                    AS valor_original,#(lf)    t.val_sdo_tit_acr                       AS saldo,#(lf)    t.val_juros                             AS juros,#(lf)    t.val_desc_tit_acr                      AS desconto,#(lf)    t.val_abat_tit_acr                      AS abatimento,#(lf)    CAST(t.log_sdo_tit_acr AS int)          AS em_aberto#(lf)FROM public.tit_acr t#(lf)WHERE t.num_id_tit_acr IS NOT NULL                 -- tira as 230 linhas de resumo#(lf)  AND CAST(t.log_tit_acr_estordo AS int) = 0       -- tira os títulos estornados", null, [EnableFolding=true])
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

